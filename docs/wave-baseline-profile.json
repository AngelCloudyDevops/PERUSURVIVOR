  "enemy": "enemy(boss=false){const s=P.state,p=s.player,a=Math.random()*Math.PI*2,r=Math.hypot(P.Core.width,P.Core.height)/(2*Math.max(1.15,P.Core.width/2400,P.Core.height/1600))+70,stage=P.Difficulty.current(),heavy=!boss&&Math.random()<stage.heavy,time=s.devRun?s.elapsed:s.mapTime,hp=boss?1800:heavy?65+time*.3:28+time*.18;const e={x:p.x+Math.cos(a)*r,y:p.y+Math.sin(a)*r,hp,max:hp,r:boss?40:heavy?19:13,speed:boss?65:heavy?46+time*.07:65+time*.09,boss,heavy,progressive:!boss,minionId:s.enemySerial,threatStage:P.Difficulty.index(),design:boss?null:s.enemySerial++%stage.types,hit:0,attackT:2,castUntil:0};return P.Attributes.init(P.MinionEvolution.apply(e))}",
  "spawn": "spawn(dt){P.Minibosses.tick(dt);const s=P.state;if(s.encounter||s.devRun)return;const policy=P.Minibosses.spawnPolicy();if(!policy.active)P.Loot.spawnKeepers();s.spawn-=dt;if(s.spawn<=0&&s.enemies.length<policy.cap){for(let i=0;i<8;i++){const candidate=P.Entities.enemy();if(P.Minibosses.spawnSafe(candidate)){s.enemies.push(candidate);break}}s.spawn=policy.interval}if(s.mapTime>=P.Data.arena.duration&&!s.bossSpawned){s.bossSpawned=true;s.portal.open=false;s.enemies.push(P.Entities.enemy(true))}}",
  "spawnPolicy": "spawnPolicy(){const active=this.active(),cap=Math.min(P.Data.arena.enemyCap,P.Difficulty.current().cap);return {active,cap:active?Math.max(8,Math.floor(cap*.5)):cap,interval:P.Difficulty.current().interval*(active?2.5:1)}}"
}
